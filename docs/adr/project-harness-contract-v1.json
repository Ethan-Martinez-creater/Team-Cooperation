    {
      "domain_fact": "project.goal.confirmed",
      "transition_key": "goal.confirmed",
      "to": ["ANALYSIS", "READY", "NONE"]
    },
    {
      "domain_fact": "project.analysis.started",
      "transition_key": "analysis.started",
      "to": ["ANALYSIS", "RUNNING", "NONE"]
    },
    {
      "domain_fact": "project.analysis.completed",
      "transition_key": "analysis.completed",
      "to": ["PLANNING", "READY", "NONE"]
    },
    {
      "domain_fact": "project.plan.approved",
      "transition_key": "plan.approved",
      "to": ["EXECUTION", "READY", "NONE"]
    },
    {
      "domain_fact": "project.work.dispatched",
      "transition_key": "work.dispatched",
      "to": ["EXECUTION", "RUNNING", "NONE"]
    },
    {
      "domain_fact": "project.work.required_submitted",
      "transition_key": "all_required_work_submitted",
      "to": ["VERIFICATION", "READY", "NONE"]
    },
    {
      "domain_fact": "project.verification.completed",
      "outcome": "FAIL",
      "transition_key": "verification.failed",
      "to": ["EXECUTION", "READY", "NONE"]
    },
    {
      "domain_fact": "project.verification.completed",
      "outcome": "PASS",
      "transition_key": "verification.passed",
      "to": ["INTEGRATION", "READY", "NONE"]
    },
    {
      "domain_fact": "project.integration.completed",
      "outcome": "PASS",
      "transition_key": "integration.passed",
      "to": ["DELIVERY", "READY", "NONE"]
    },
    {
      "domain_fact": "project.delivery.accepted",
      "transition_key": "delivery.accepted",
      "to": ["TERMINAL", "COMPLETED", "NONE"]
    },
    {
      "domain_fact": "project.delivery.rejected",
      "transition_key": "delivery.rejected",
      "to": ["EXECUTION", "READY", "NONE"]
    }
  ],
  "version_policy": {
    "domain_fact_advances_event_sequence": true,
    "only_transition_advances_process_version": true,
    "planner_stale_inputs": [
      "process_version",
      "last_event_sequence",
      "graph_snapshot_digest"
    ]
  },
  "execution_identity": {
    "planner_executed_as": "service:project-orchestrator",
    "task_executed_as_prefix": "team-agent:",
    "automatic_run_requires_initiated_by": true,
    "automatic_run_requires_executed_as": true
  },
  "rework_policy": {
    "team_task_changes_requested_returns_to": "in_progress",
    "deterministic_task_reopen_counts_as_replan": false,
    "graph_or_scope_mutation_counts_as_replan": true
  }
}

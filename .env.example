# Copy to .env locally and fill values. Never commit .env.
COIFESP_ENV=
# local: built-in demo profiles; oidc: Keycloak or another organization IdP.
COIFESP_AUTH_MODE=local
COIFESP_DATABASE_URL=
COIFESP_OIDC_ISSUER=
COIFESP_OIDC_AUDIENCE=
COIFESP_OIDC_AUTHORIZED_PARTIES=
COIFESP_UI_OIDC_CLIENT_ID=coifesp-local-ui
COIFESP_OIDC_JWKS_URL=
COIFESP_OIDC_ALGORITHMS=RS256
COIFESP_OIDC_TENANT_CLAIM=tenant_id
COIFESP_OIDC_ROLES_CLAIM=roles
COIFESP_OIDC_COMPARTMENTS_CLAIM=compartments
COIFESP_OIDC_CLEARANCE_CLAIM=clearance
COIFESP_OIDC_CLOCK_SKEW_SECONDS=30
COIFESP_OIDC_MAX_TOKEN_AGE_SECONDS=3600
# Durable worker machine identity. Secrets are distinct and must be filled locally.
COIFESP_WORKER_TOKEN_ENDPOINT=
COIFESP_WORKER_CLIENT_ID=coifesp-agent-worker
COIFESP_WORKER_CLIENT_SECRET=
# Recommended production mode: bounded, comma-separated shared-pool allowlist.
COIFESP_WORKER_TENANTS=
# Legacy single-tenant compatibility only; never set with COIFESP_WORKER_TENANTS.
COIFESP_WORKER_TENANT_ID=
COIFESP_DIRECTORY_API_BASE_URL=
COIFESP_DIRECTORY_REALM=coifesp
COIFESP_DIRECTORY_TOKEN_ENDPOINT=
COIFESP_DIRECTORY_CLIENT_ID=coifesp-directory-reader
COIFESP_DIRECTORY_CLIENT_SECRET=
COIFESP_WORKER_IDLE_POLL_SECONDS=2
COIFESP_WORKER_LEASE_SECONDS=60
COIFESP_WORKER_HEARTBEAT_SECONDS=20
# Separately credentialed Tool Worker. Never reuse Agent/directory credentials.
COIFESP_TOOL_WORKER_TOKEN_ENDPOINT=
COIFESP_TOOL_WORKER_CLIENT_ID=coifesp-tool-worker
COIFESP_TOOL_WORKER_CLIENT_SECRET=
# Recommended production mode: normally the same allowlist as the Agent Worker pool.
COIFESP_TOOL_WORKER_TENANTS=
# Legacy single-tenant compatibility only; never set with COIFESP_TOOL_WORKER_TENANTS.
COIFESP_TOOL_WORKER_TENANT_ID=
COIFESP_TOOL_WORKER_IDLE_POLL_SECONDS=2
COIFESP_TOOL_WORKER_LEASE_SECONDS=60
COIFESP_TOOL_WORKER_HEARTBEAT_SECONDS=20
COIFESP_SANDBOX_RUNTIME=
COIFESP_SANDBOX_WORKSPACE_ROOT=
# Strict JSON list; images require @sha256 digests and an array arguments_schema.
COIFESP_SANDBOX_PROFILES_JSON=
# Connector JSON references secrets by COIFESP_CONNECTOR_*_CLIENT_SECRET env name.
COIFESP_CONNECTORS_JSON=
COIFESP_OFFICE_DATA_CLASSIFICATION=internal
COIFESP_ARTIFACT_STORE_ROOT=./runtime-data/artifacts
COIFESP_ARTIFACT_MAX_UPLOAD_BYTES=104857600
COIFESP_AUDIT_KEY_ID=
COIFESP_AUDIT_SIGNING_KEY=
# Rotation form: strict JSON references secret environment variables; never inline keys.
COIFESP_AUDIT_KEYS_JSON=
COIFESP_ENVELOPE_KEY_ID=
COIFESP_ENVELOPE_LEGACY_V1_KEY_ID=
COIFESP_ENVELOPE_SIGNING_KEY=
COIFESP_ENVELOPE_KEYS_JSON=
COIFESP_MEMORY_KEY_ID=
COIFESP_MEMORY_MASTER_KEY=
COIFESP_MEMORY_KEYS_JSON=
COIFESP_LLM_PROVIDER=
COIFESP_LLM_MODEL=
COIFESP_LLM_BASE_URL=
COIFESP_LLM_API_KEY=
# Production gateway registry. Keep JSON on one line and reference API keys by env name.
COIFESP_LLM_PROVIDERS_JSON=
# Local-development test authorization only. Comma-separated external Provider IDs
# that may receive INTERNAL demo-project context. Keep empty in production.
COIFESP_LOCAL_EXTERNAL_INTERNAL_PROVIDERS=
COIFESP_LLM_MAX_FAILOVER_ATTEMPTS=2
COIFESP_LLM_CONCURRENCY_WAIT_SECONDS=2
COIFESP_LLM_CIRCUIT_FAILURE_THRESHOLD=3
COIFESP_LLM_CIRCUIT_COOLDOWN_SECONDS=30
COIFESP_SERVICE_NAME=coifesp-harness
COIFESP_TELEMETRY_ENABLED=false
COIFESP_OTLP_TRACES_ENDPOINT=
COIFESP_TRACE_SAMPLE_RATIO=1.0
COIFESP_METRICS_ENABLED=false
COIFESP_METRICS_PATH=/internal/metrics
COIFESP_METRICS_BEARER_TOKEN=
COIFESP_STRUCTURED_LOGGING=false
COIFESP_LOG_LEVEL=INFO

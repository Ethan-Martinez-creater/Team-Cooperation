# Copy to E:\keyclock\runtime\keycloak.env and fill every secret locally.
# Never commit the filled file.
JAVA_HOME=E:\openjdk\jdk-21.0.12+8
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://127.0.0.1:5432/keycloak
KC_DB_USERNAME=keycloak_runtime
KC_DB_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=coifesp-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
KC_HTTP_ENABLED=true
KC_HTTP_HOST=127.0.0.1
KC_HTTP_PORT=8080
KC_HOSTNAME=http://127.0.0.1:8080
KC_HOSTNAME_STRICT=true
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
KC_CACHE=local
KC_LOG_LEVEL=INFO

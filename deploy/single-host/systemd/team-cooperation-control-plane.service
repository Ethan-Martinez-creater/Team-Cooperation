[Unit]
Description=Team Cooperation control plane
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=teamcoop
Group=teamcoop
WorkingDirectory=/opt/team-cooperation/current
EnvironmentFile=/opt/team-cooperation/config/app.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/team-cooperation/current/src
ExecStart=/opt/team-cooperation/venv/bin/python -m uvicorn coifesp_harness.control_plane.bootstrap:create_application --factory --host 127.0.0.1 --port 8020 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/team-cooperation/runtime-data
MemoryMax=1536M

[Install]
WantedBy=multi-user.target

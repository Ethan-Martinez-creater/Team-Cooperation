[Unit]
Description=Team Cooperation shared multi-tenant Tool Worker
After=network-online.target team-cooperation-control-plane.service
Wants=network-online.target

[Service]
Type=simple
User=teamcoop
Group=teamcoop
WorkingDirectory=/opt/team-cooperation/current
EnvironmentFile=/opt/team-cooperation/config/app.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/team-cooperation/current/src
Environment=HOME=/opt/team-cooperation/home
RuntimeDirectory=team-cooperation-tool
RuntimeDirectoryMode=0700
ExecStart=/opt/team-cooperation/current/deploy/single-host/run-tool-worker.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=660
NoNewPrivileges=true
Delegate=yes
PrivateTmp=true
ProtectHome=false
ProtectSystem=strict
ReadWritePaths=/opt/team-cooperation/runtime-data /opt/team-cooperation/home /run/team-cooperation-tool
MemoryMax=2048M

[Install]
WantedBy=multi-user.target

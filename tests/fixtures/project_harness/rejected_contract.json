          "step_ref": "t07",
          "trigger_event_ref": "e11",
          "from": { "phase": "DELIVERY", "status": "READY", "wait_reason": "NONE" },
          "to": { "phase": "TERMINAL", "status": "COMPLETED", "wait_reason": "NONE" },
          "process_version_change": "+1",
          "transition_event_type": "delivery.accepted"
        }

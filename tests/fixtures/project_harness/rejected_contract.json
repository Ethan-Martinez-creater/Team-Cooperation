        { "forbidden_id": "fo-02", "kind": "dispatch", "statement": "无限自动重试循环：拒绝后不经重规划反复触发 dispatch/negotiation" },
        { "forbidden_id": "fo-03", "kind": "state", "statement": "planner 决策绕过 stale guard 直接应用，或 planner command 直接指定 task 状态为 accepted/verified（G-INV-01）" },
        { "forbidden_id": "fo-04", "kind": "state", "statement": "replan 静默覆盖旧计划：plan-v1 或被拒 task 的记录消失（应 supersedes 保留）" },
        { "forbidden_id": "fo-05", "kind": "usage", "statement": "replan_count 不增长，或达到 max_replans 后仍继续发起新 replan" },
        { "forbidden_id": "fo-06", "kind": "state", "statement": "拒绝事件把 process 直接置为 FAILED（拒绝是重规划信号，不是项目失败）" }
      ],
      "safety_invariants": [
        { "invariant_id": "si-01", "statement": "planner replan run 的 executed_as 为受验证服务/规划主体，而非真实用户；其输出仅为 command 草案，应用前经 schema/policy/graph 三重验证（计划 7.5）" },
        { "invariant_id": "si-02", "statement": "同一 (process_version, orchestration_reason, graph_snapshot_digest) 只产生一个 replan intent；本场景崩溃重放不产生第二个并行 planner run（G-INV-11）" }
      ],
      "crash_and_recovery": [
        {
          "recovery_id": "cr-01",
          "injected_fault": "orchestrator_worker_crash（可选变体：在 replan run 创建后、decision 应用前崩溃）",
          "expected_behavior": "重启后按确定性 planner intent 恢复：不创建第二个并行 planner run；已应用的 command 幂等收敛",
          "recovery_signal": "orchestrator worker 重新认领 process lease",
          "idempotency_requirement": "decision/command 按 command_id、request_digest 去重；重放后状态与单次执行一致"
        }
      ],
      "contract_assumptions": ["OPEN-Q1", "OPEN-Q3", "OPEN-Q4", "OPEN-Q11", "OPEN-Q12"]

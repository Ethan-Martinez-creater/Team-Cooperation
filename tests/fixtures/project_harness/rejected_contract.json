      "required_outputs": [
        { "output_id": "ro-01", "kind": "state", "statement": "replan 恰好发生一次：execution_usage.replan_count 从 0 到 1，且低于 policy.max_replans", "subject_refs": ["process-demo-1"] },
        { "output_id": "ro-02", "kind": "state", "statement": "plan-v2 以 supersedes 关系取代 plan-v1；task-backend-api（rejected）记录保留、未被删除或静默改写；新计划不覆盖已完成工作", "subject_refs": ["plan-v1", "task-backend-api", "task-api-v2"] },
        { "output_id": "ro-03", "kind": "state", "statement": "planner decision 通过 stale guard（based_on_process_version 与 graph_snapshot_digest 均匹配当前值）后才被幂等应用（G-INV-11）", "subject_refs": ["planner-replan-run-1"] },
        { "output_id": "ro-04", "kind": "event", "statement": "e01 拒绝事件产生一条 wakeup 且被消费一次；同一拒绝不触发多次 replan" },
        { "output_id": "ro-05", "kind": "state", "statement": "task-api-v2 走完整生命周期 proposed → accepted → in_progress → submitted → verified，dispatch 前满足 readiness（已接受 + 依赖满足 + 容量预留）", "subject_refs": ["task-api-v2"] }
